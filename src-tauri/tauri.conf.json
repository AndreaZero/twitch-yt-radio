{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Background Audio",
  "version": "0.1.0",
  "identifier": "dev.andreazero.backgroundaudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Background Audio",
        "width": 450,
        "height": 540,
        "minWidth": 370,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "windowEffects": { "effects": ["acrylic"] },
        "center": true,
        "resizable": true
      },
      {
        "label": "chat",
        "title": "Background Audio - Chat Twitch",
        "width": 380,
        "height": 580,
        "minWidth": 330,
        "minHeight": 280,
        "visible": false,
        "resizable": true
      },
      {
        "label": "youtube-chat",
        "title": "Background Audio - YouTube",
        "width": 380,
        "height": 580,
        "minWidth": 330,
        "minHeight": 280,
        "visible": false,
        "resizable": true
      },
      {
        "label": "video",
        "title": "Background Audio - Video",
        "width": 400,
        "height": 280,
        "minWidth": 370,
        "minHeight": 200,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false },
      "nsis": { "installMode": "currentUser" }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
